{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Laboratorio de incidencias con cuatro instancias EC2 x86_64",
  "Parameters": {
    "KeyName": {
      "Type": "AWS::EC2::KeyPair::KeyName"
    },
    "OperatorCidr": {
      "Type": "String",
      "AllowedPattern": "^(?:[0-9]{1,3}\\.){3}[0-9]{1,3}/32$",
      "Description": "IPv4 publica del operador, con mascara /32"
    },
    "Ami": {
      "Type": "AWS::SSM::Parameter::Value<AWS::EC2::Image::Id>",
      "Default": "/aws/service/ami-amazon-linux-latest/al2023-ami-kernel-default-x86_64"
    },
    "FrontendInstanceType": {
      "Type": "String",
      "Default": "t3.small"
    },
    "BackendInstanceType": {
      "Type": "String",
      "Default": "t3.small"
    },
    "DatabaseInstanceType": {
      "Type": "String",
      "Default": "t3.small"
    },
    "AutomationInstanceType": {
      "Type": "String",
      "Default": "t3.small"
    }
  },
  "Resources": {
    "Vpc": {
      "Type": "AWS::EC2::VPC",
      "Properties": {
        "CidrBlock": "10.42.0.0/16",
        "EnableDnsSupport": true,
        "EnableDnsHostnames": true,
        "Tags": [
          {
            "Key": "Name",
            "Value": {
              "Fn::Sub": "${AWS::StackName}-vpc"
            }
          }
        ]
      }
    },
    "InternetGateway": {
      "Type": "AWS::EC2::InternetGateway",
      "Properties": {
        "Tags": [
          {
            "Key": "Name",
            "Value": {
              "Fn::Sub": "${AWS::StackName}-igw"
            }
          }
        ]
      }
    },
    "GatewayAttachment": {
      "Type": "AWS::EC2::VPCGatewayAttachment",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "InternetGatewayId": {
          "Ref": "InternetGateway"
        }
      }
    },
    "Subnet": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "CidrBlock": "10.42.1.0/24",
        "Tags": [
          {
            "Key": "Name",
            "Value": {
              "Fn::Sub": "${AWS::StackName}-subnet"
            }
          }
        ]
      }
    },
    "RouteTable": {
      "Type": "AWS::EC2::RouteTable",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        }
      }
    },
    "InternetRoute": {
      "Type": "AWS::EC2::Route",
      "DependsOn": "GatewayAttachment",
      "Properties": {
        "RouteTableId": {
          "Ref": "RouteTable"
        },
        "DestinationCidrBlock": "0.0.0.0/0",
        "GatewayId": {
          "Ref": "InternetGateway"
        }
      }
    },
    "SubnetRoute": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": {
          "Ref": "Subnet"
        },
        "RouteTableId": {
          "Ref": "RouteTable"
        }
      }
    },
    "FrontendSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "Incidencias frontend",
        "VpcId": {
          "Ref": "Vpc"
        },
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 22,
            "ToPort": 22,
            "CidrIp": {
              "Ref": "OperatorCidr"
            }
          }
        ],
        "Tags": [
          {
            "Key": "Name",
            "Value": {
              "Fn::Sub": "${AWS::StackName}-frontend"
            }
          }
        ]
      }
    },
    "Frontend": {
      "Type": "AWS::EC2::Instance",
      "DependsOn": [
        "InternetRoute",
        "SubnetRoute"
      ],
      "Properties": {
        "ImageId": {
          "Ref": "Ami"
        },
        "InstanceType": {
          "Ref": "FrontendInstanceType"
        },
        "KeyName": {
          "Ref": "KeyName"
        },
        "MetadataOptions": {
          "HttpTokens": "required"
        },
        "NetworkInterfaces": [
          {
            "DeviceIndex": "0",
            "AssociatePublicIpAddress": true,
            "SubnetId": {
              "Ref": "Subnet"
            },
            "GroupSet": [
              {
                "Ref": "FrontendSecurityGroup"
              }
            ]
          }
        ],
        "BlockDeviceMappings": [
          {
            "DeviceName": "/dev/xvda",
            "Ebs": {
              "VolumeType": "gp3",
              "VolumeSize": 20,
              "Encrypted": true,
              "DeleteOnTermination": false
            }
          }
        ],
        "Tags": [
          {
            "Key": "Name",
            "Value": {
              "Fn::Sub": "${AWS::StackName}-frontend"
            }
          }
        ]
      }
    },
    "BackendSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "Incidencias backend",
        "VpcId": {
          "Ref": "Vpc"
        },
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 22,
            "ToPort": 22,
            "CidrIp": {
              "Ref": "OperatorCidr"
            }
          }
        ],
        "Tags": [
          {
            "Key": "Name",
            "Value": {
              "Fn::Sub": "${AWS::StackName}-backend"
            }
          }
        ]
      }
    },
    "Backend": {
      "Type": "AWS::EC2::Instance",
      "DependsOn": [
        "InternetRoute",
        "SubnetRoute"
      ],
      "Properties": {
        "ImageId": {
          "Ref": "Ami"
        },
        "InstanceType": {
          "Ref": "BackendInstanceType"
        },
        "KeyName": {
          "Ref": "KeyName"
        },
        "MetadataOptions": {
          "HttpTokens": "required"
        },
        "NetworkInterfaces": [
          {
            "DeviceIndex": "0",
            "AssociatePublicIpAddress": true,
            "SubnetId": {
              "Ref": "Subnet"
            },
            "GroupSet": [
              {
                "Ref": "BackendSecurityGroup"
              }
            ]
          }
        ],
        "BlockDeviceMappings": [
          {
            "DeviceName": "/dev/xvda",
            "Ebs": {
              "VolumeType": "gp3",
              "VolumeSize": 20,
              "Encrypted": true,
              "DeleteOnTermination": false
            }
          }
        ],
        "Tags": [
          {
            "Key": "Name",
            "Value": {
              "Fn::Sub": "${AWS::StackName}-backend"
            }
          }
        ]
      }
    },
    "DatabaseSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "Incidencias db",
        "VpcId": {
          "Ref": "Vpc"
        },
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 22,
            "ToPort": 22,
            "CidrIp": {
              "Ref": "OperatorCidr"
            }
          }
        ],
        "Tags": [
          {
            "Key": "Name",
            "Value": {
              "Fn::Sub": "${AWS::StackName}-db"
            }
          }
        ]
      }
    },
    "Database": {
      "Type": "AWS::EC2::Instance",
      "DependsOn": [
        "InternetRoute",
        "SubnetRoute"
      ],
      "Properties": {
        "ImageId": {
          "Ref": "Ami"
        },
        "InstanceType": {
          "Ref": "DatabaseInstanceType"
        },
        "KeyName": {
          "Ref": "KeyName"
        },
        "MetadataOptions": {
          "HttpTokens": "required"
        },
        "NetworkInterfaces": [
          {
            "DeviceIndex": "0",
            "AssociatePublicIpAddress": true,
            "SubnetId": {
              "Ref": "Subnet"
            },
            "GroupSet": [
              {
                "Ref": "DatabaseSecurityGroup"
              }
            ]
          }
        ],
        "BlockDeviceMappings": [
          {
            "DeviceName": "/dev/xvda",
            "Ebs": {
              "VolumeType": "gp3",
              "VolumeSize": 20,
              "Encrypted": true,
              "DeleteOnTermination": false
            }
          }
        ],
        "Tags": [
          {
            "Key": "Name",
            "Value": {
              "Fn::Sub": "${AWS::StackName}-db"
            }
          }
        ]
      }
    },
    "AutomationSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "Incidencias n8n",
        "VpcId": {
          "Ref": "Vpc"
        },
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 22,
            "ToPort": 22,
            "CidrIp": {
              "Ref": "OperatorCidr"
            }
          },
          {
            "IpProtocol": "tcp",
            "FromPort": 80,
            "ToPort": 80,
            "CidrIp": "0.0.0.0/0"
          },
          {
            "IpProtocol": "tcp",
            "FromPort": 443,
            "ToPort": 443,
            "CidrIp": "0.0.0.0/0"
          }
        ],
        "Tags": [
          {
            "Key": "Name",
            "Value": {
              "Fn::Sub": "${AWS::StackName}-n8n"
            }
          }
        ]
      }
    },
    "Automation": {
      "Type": "AWS::EC2::Instance",
      "DependsOn": [
        "InternetRoute",
        "SubnetRoute"
      ],
      "Properties": {
        "ImageId": {
          "Ref": "Ami"
        },
        "InstanceType": {
          "Ref": "AutomationInstanceType"
        },
        "KeyName": {
          "Ref": "KeyName"
        },
        "MetadataOptions": {
          "HttpTokens": "required"
        },
        "NetworkInterfaces": [
          {
            "DeviceIndex": "0",
            "AssociatePublicIpAddress": true,
            "SubnetId": {
              "Ref": "Subnet"
            },
            "GroupSet": [
              {
                "Ref": "AutomationSecurityGroup"
              }
            ]
          }
        ],
        "BlockDeviceMappings": [
          {
            "DeviceName": "/dev/xvda",
            "Ebs": {
              "VolumeType": "gp3",
              "VolumeSize": 20,
              "Encrypted": true,
              "DeleteOnTermination": false
            }
          }
        ],
        "Tags": [
          {
            "Key": "Name",
            "Value": {
              "Fn::Sub": "${AWS::StackName}-n8n"
            }
          }
        ]
      }
    },
    "FrontendToBackend": {
      "Type": "AWS::EC2::SecurityGroupIngress",
      "Properties": {
        "GroupId": {
          "Ref": "BackendSecurityGroup"
        },
        "SourceSecurityGroupId": {
          "Ref": "FrontendSecurityGroup"
        },
        "IpProtocol": "tcp",
        "FromPort": 3000,
        "ToPort": 3000
      }
    },
    "AutomationToBackend": {
      "Type": "AWS::EC2::SecurityGroupIngress",
      "Properties": {
        "GroupId": {
          "Ref": "BackendSecurityGroup"
        },
        "SourceSecurityGroupId": {
          "Ref": "AutomationSecurityGroup"
        },
        "IpProtocol": "tcp",
        "FromPort": 3000,
        "ToPort": 3000
      }
    },
    "BackendToDatabase": {
      "Type": "AWS::EC2::SecurityGroupIngress",
      "Properties": {
        "GroupId": {
          "Ref": "DatabaseSecurityGroup"
        },
        "SourceSecurityGroupId": {
          "Ref": "BackendSecurityGroup"
        },
        "IpProtocol": "tcp",
        "FromPort": 5432,
        "ToPort": 5432
      }
    },
    "WebhookAddress": {
      "Type": "AWS::EC2::EIP",
      "DependsOn": "GatewayAttachment",
      "Properties": {
        "Domain": "vpc",
        "Tags": [
          {
            "Key": "Name",
            "Value": {
              "Fn::Sub": "${AWS::StackName}-webhook"
            }
          }
        ]
      }
    },
    "WebhookAddressAssociation": {
      "Type": "AWS::EC2::EIPAssociation",
      "Properties": {
        "AllocationId": {
          "Fn::GetAtt": [
            "WebhookAddress",
            "AllocationId"
          ]
        },
        "InstanceId": {
          "Ref": "Automation"
        }
      }
    }
  },
  "Outputs": {
    "FrontendPublicIp": {
      "Value": {
        "Fn::GetAtt": [
          "Frontend",
          "PublicIp"
        ]
      }
    },
    "BackendPublicIp": {
      "Value": {
        "Fn::GetAtt": [
          "Backend",
          "PublicIp"
        ]
      }
    },
    "BackendPrivateIp": {
      "Value": {
        "Fn::GetAtt": [
          "Backend",
          "PrivateIp"
        ]
      }
    },
    "DatabasePublicIp": {
      "Value": {
        "Fn::GetAtt": [
          "Database",
          "PublicIp"
        ]
      }
    },
    "DatabasePrivateIp": {
      "Value": {
        "Fn::GetAtt": [
          "Database",
          "PrivateIp"
        ]
      }
    },
    "AutomationPublicIp": {
      "Value": {
        "Ref": "WebhookAddress"
      }
    }
  }
}
