TELEGRAM_BOT_TOKEN=
INCIDENT_DUE_HOURS=48
INCIDENT_ESCALATION_HOURS=0
PORT=3001
# Optional: absolute path to persistent local photo storage. No cloud copy.
# PHOTO_STORAGE_DIR=C:/proyecto-incidencias/backend/uploads/photos
VITE_API_URL=http://localhost:3001/api
SUPERADMIN1_PASSWORD=example-superadmin-one-password
SUPERADMIN2_PASSWORD=example-superadmin-two-password
VITE_MAP_DEFAULT_LATITUDE=19.4326
VITE_MAP_DEFAULT_LONGITUDE=-99.1332
