POSTGRES_USER=admin
POSTGRES_PASSWORD=local-development-password-change-before-deploying
POSTGRES_DB=incidencias
DB_HOST=localhost
DB_PORT=5432
DB_NAME=incidencias
DB_USER=postgres
DB_PASSWORD=example-password
FRONTEND_ORIGIN=http://localhost:8080,http://localhost:5175,http://127.0.0.1:5175
JWT_SECRET=local-development-only-change-this-secret-before-deploying
