# Variables de producción para el proceso/contenedor backend.
# Inyectar secretos desde AWS Secrets Manager; no publicar un archivo real.
NODE_ENV=production
PORT=3000
FRONTEND_ORIGIN=https://incidencias.tu-dominio.com
JWT_SECRET=REEMPLAZAR_POR_UN_SECRETO_ALEATORIO_DE_32_BYTES_O_MAS
DB_HOST=REEMPLAZAR_POR_ENDPOINT_RDS
DB_PORT=5432
DB_NAME=incidencias
DB_USER=incidencias_app
DB_PASSWORD=REEMPLAZAR
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=true
# Certificado PEM de la CA RDS, con saltos de línea escapados como \n.
DATABASE_SSL_CA=
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=5000
MIGRATE_ON_START=false
# ALB directo al backend: 1. ALB -> Nginx -> backend: 2.
# Usar solo si el backend no es accesible fuera de esa cadena de proxies.
TRUST_PROXY_HOPS=2
JSON_BODY_LIMIT=1mb
